# Copy this file to .env and fill in what you have. Never commit .env.
# Everything is optional for a first run: without keys, list loading shows a clear
# "not configured" message and every store falls back to a plain search link.

# https://myanimelist.net/apiconfig -> Create ID
MAL_CLIENT_ID=
# Only for "Sign in with MyAnimeList" (private lists). On the same apiconfig page, set the
# app's Redirect URL to http://localhost:5173/api/anime/auth/callback
MAL_CLIENT_SECRET=
# Where browsers reach the site; MAL sends people back to PUBLIC_URL/api/anime/auth/callback
PUBLIC_URL=http://localhost:5173
# Encrypts the sign-in cookie. Any random string locally; in AWS, SSM /oshiloot/session_secret
SESSION_SECRET=dev-only-session-secret

# https://developer.ebay.com -> Application Keys (production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
# eBay Partner Network campaign ID; adds commission tracking to eBay links
EBAY_CAMPAIGN_ID=

# From CDJapan's "Create Link to Arbitrary Page" menu, with {path} where the destination goes
CDJAPAN_AFFILIATE_TEMPLATE=

# Any random string locally. In AWS it comes from SSM (/oshiloot/link_signing_key).
LINK_SIGNING_KEY=dev-only-not-a-secret
